{
  "name": "islamic-cinematic-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "stills": "remotion still src/index.ts CourtyardTest out/frame000.png --frame=0 --scale=0.5 --props=preview-props.json && remotion still src/index.ts CourtyardTest out/frame150.png --frame=150 --scale=0.5 --props=preview-props.json && remotion still src/index.ts CourtyardTest out/frame299.png --frame=299 --scale=0.5 --props=preview-props.json",
    "preview": "remotion render src/index.ts CourtyardTest out/preview.mp4 --codec=h264 --muted --scale=0.5 --props=preview-props.json",
    "fullsize-test": "remotion render src/index.ts CourtyardTest out/fullsize_test.mp4 --frames=150-210 --codec=h264 --muted",
    "final": "remotion render src/index.ts CourtyardTest out/final.mp4 --codec=h264 --crf=16 --muted"
  },
  "dependencies": {
    "@react-three/fiber": "9.1.2",
    "@react-three/postprocessing": "3.0.4",
    "@remotion/cli": "4.0.290",
    "@remotion/three": "4.0.290",
    "postprocessing": "6.37.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.290",
    "three": "0.175.0"
  },
  "devDependencies": {
    "@types/react": "19.0.10",
    "@types/three": "0.175.0",
    "typescript": "5.8.3"
  }
}
