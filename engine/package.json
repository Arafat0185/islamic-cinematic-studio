{
  "name": "islamic-cinematic-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "stills": "remotion still src/index.ts CourtyardTest out/frame000.png --frame=0 --scale=0.5 --props=preview-props.json && remotion still src/index.ts CourtyardTest out/frame150.png --frame=150 --scale=0.5 --props=preview-props.json && remotion still src/index.ts CourtyardTest out/frame299.png --frame=299 --scale=0.5 --props=preview-props.json",
    "preview": "remotion render src/index.ts CourtyardTest out/preview.mp4 --codec=h264 --muted --scale=0.5 --props=preview-props.json",
    "fullsize-test": "remotion render src/index.ts CourtyardTest out/fullsize_test.mp4 --frames=150-210 --codec=h264 --muted",
    "final": "remotion render src/index.ts CourtyardTest out/final.mp4 --codec=h264 --crf=16 --muted",
    "pose-sheet": "remotion still src/index.ts PoseSheet out/pose_sheet.png",
    "motion-test": "remotion render src/index.ts TravellerMotionTest out/motion_test.mp4 --codec=h264 --crf=16 --muted",
    "beauty": "remotion still src/index.ts BeautyWide out/beauty_wide.png && remotion still src/index.ts BeautyLow out/beauty_low.png && remotion still src/index.ts BeautyClose out/beauty_close.png",
    "toolkit-stills": "remotion still src/index.ts BrandToolkitDemo out/toolkit_opening.png --frame=24 && remotion still src/index.ts BrandToolkitDemo out/toolkit_grooves.png --frame=44 && remotion still src/index.ts BrandToolkitDemo out/toolkit_captions.png --frame=120 && remotion still src/index.ts BrandToolkitDemo out/toolkit_wipe.png --frame=189 && remotion still src/index.ts BrandToolkitDemo out/toolkit_hadith.png --frame=330 && remotion still src/index.ts BrandToolkitDemo out/toolkit_warning.png --frame=500 && remotion still src/index.ts BrandToolkitDemo out/toolkit_mercy.png --frame=580 && remotion still src/index.ts BrandToolkitDemo out/toolkit_ending.png --frame=700 && remotion still src/index.ts BrandToolkitDemo out/toolkit_sources.png --frame=742",
    "toolkit": "remotion render src/index.ts BrandToolkitDemo out/toolkit_demo.mp4 --codec=h264 --crf=16 --muted",
    "toolkit-v2": "remotion render src/index.ts BrandToolkitDemo out/toolkit_demo_v2.mp4 --codec=h264 --crf=16 --muted",
    "toolkit-v3": "remotion render src/index.ts BrandToolkitDemo out/toolkit_demo_v3.mp4 --codec=h264 --crf=16 --muted",
    "camera-report": "remotion still src/index.ts BrandToolkitDemo out/camera_report.png --frame=100 --scale=0.5 --props={\\\"post\\\":{\\\"camReport\\\":true,\\\"dpr\\\":0.5}} --log=verbose",
    "video001-voice": ".venv-tts/Scripts/python tools/narrate.py ../videos/001-the-first-question && .venv-tts/Scripts/python tools/align_words.py ../videos/001-the-first-question",
    "video001-mix": ".venv-tts/Scripts/python tools/mix.py ../videos/001-the-first-question src/scenes/video001/film.json public/audio/video001_mix.wav",
    "video001": "remotion render src/index.ts Video001 out/video001_draft1.mp4 --codec=h264 --crf=16 --audio-codec=aac --audio-bitrate=192k",
    "video001-d2-plan": ".venv-tts/Scripts/python tools/plan_video001_d2.py ../videos/001-the-first-question",
    "video001-d2-mix": ".venv-tts/Scripts/python tools/mix_d2.py ../videos/001-the-first-question public/audio/video001_d2_mix.wav",
    "video001-d2": "remotion render src/index.ts Video001D2 out/video001_draft2.mp4 --codec=h264 --crf=16 --audio-codec=aac --audio-bitrate=192k",
    "video001-d3-voice": ".venv-tts/Scripts/python tools/narrate_blocks.py ../videos/001-the-first-question",
    "video001-d3-plan": ".venv-tts/Scripts/python tools/plan_video001_d3.py ../videos/001-the-first-question",
    "video001-d3-mix": ".venv-tts/Scripts/python tools/mix_d3.py ../videos/001-the-first-question public/audio/video001_d3_mix.wav",
    "video001-d3": "node tools/render-chunks.mjs Video001D3 out/video001_draft3.mp4 --chunk 600 --audio public/audio/video001_d3_mix.wav",
    "render-chunks": "node tools/render-chunks.mjs",
    "final001-voice": ".venv-tts/Scripts/python tools/narrate_final.py ../videos/001-the-first-question",
    "final001-plan": ".venv-tts/Scripts/python tools/plan_final001.py ../videos/001-the-first-question",
    "final001-mix": ".venv-tts/Scripts/python tools/mix_final001.py ../videos/001-the-first-question public/audio/final001_mix.wav",
    "final001": "node tools/render-chunks.mjs TheFirstQuestionFinal out/The_First_Question_FINAL.mp4 --chunk 600 --audio public/audio/final001_mix.wav",
    "quran001-timing": ".venv-tts/Scripts/python tools/build_quran_timing.py",
    "quran001-mix": ".venv-tts/Scripts/python tools/mix_quran001.py",
    "quran001": "node tools/render-chunks.mjs TheFirstQuestionQuran out/The_First_Question_QURAN.mp4 --chunk 600 --audio public/audio/quran001_mix.wav --keep && npx remotion ffmpeg -v error -y -i out/The_First_Question_QURAN.mp4 -i public/audio/quran001_preview_mix.wav -map 0:v:0 -map 1:a:0 -c:v copy -c:a aac -b:a 192k -shortest out/The_First_Question_QURAN_PREVIEW.mp4",
    "quran001-qa": ".venv-tts/Scripts/python tools/qa_quran001.py out/The_First_Question_QURAN.mp4 out/The_First_Question_QURAN_PREVIEW.mp4 out/qa_quran001"
  },
  "dependencies": {
    "@fontsource/amiri": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@react-three/fiber": "9.1.2",
    "@react-three/postprocessing": "3.0.4",
    "@remotion/cli": "4.0.290",
    "@remotion/three": "4.0.290",
    "postprocessing": "6.37.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.290",
    "three": "0.175.0"
  },
  "devDependencies": {
    "@types/react": "19.0.10",
    "@types/three": "0.175.0",
    "typescript": "5.8.3"
  }
}
